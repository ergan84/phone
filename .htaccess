<IfModule dir_module>
    DirectoryIndex index.php index.html
</IfModule>
AddDefaultCharset UTF-8
AddCharset UTF-8 .html
<FilesMatch "\.(html)$">
   Header set Cache-Control: "no-cache, no-store"
   Header unset ETag
</FilesMatch>
Header set X-Content-Type-Options nosniff

# Запрещаем прямую отдачу конфига и резервных копий с секретами
<FilesMatch "(^config\.php$|\.bak$)">
    Require all denied
</FilesMatch>